# ==============================================================================
# SentinelAgent - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and replace placeholders with your actual credentials.
# Do NOT commit actual secrets or credentials to version control.

# Application Settings
APP_NAME="SentinelAgent API"
APP_DESCRIPTION="AI-Powered Cybersecurity Investigation System"
APP_VERSION="0.1.0"
API_PREFIX="/api"
DEBUG=false

# PostgreSQL Database Connection
# Format: postgresql+psycopg://sentinelagent_user:<password>@localhost:5432/sentinelagent
DATABASE_URL="postgresql+psycopg://sentinelagent_user:<password>@localhost:5432/sentinelagent"

# Google Gemini API Settings (Task 7B Investigation Agent)
# Optional API key for Google Gemini (application starts normally if omitted)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-3.8-flash"
GEMINI_MAX_OUTPUT_TOKENS=8192
GEMINI_TIMEOUT_SECONDS=120
GEMINI_THINKING_LEVEL="medium"

