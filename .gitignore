# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
ENV/
env/

# Node / Frontend build artifacts
node_modules/
**/node_modules/
frontend/dist/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files and credentials
# Strictly ignore all actual .env files across the workspace
.env
.env.*
*.env
**/.env
**/.env.*
deploy/sentinelagent/.env
deploy/hindsight/.env.hindsight

# Explicitly track safe example configuration templates
!.env.example
!.env.*.example
!deploy/sentinelagent/.env.example
!deploy/hindsight/.env.hindsight.example

# Secrets directories and generated key material
secrets/
**/secrets/
deploy/sentinelagent/secrets/
*.pem
*.key
*.crt
*.p12
*.pfx

# Database files, volumes, and dumps
*.dump
*.sql.gz
*.rdb
*.sqlite
*.sqlite3
pgdata/
**/pgdata/

# Logs and local diagnostic scratch directories
*.log
logs/
**/logs/
scratch/
**/scratch/
temp/
tmp/

# Testing and coverage
.pytest_cache/
.coverage
htmlcov/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo

# OS files
Thumbs.db
Desktop.ini
.DS_Store

# Large datasets & raw STIX upstream files
backend/app/data/mitre/upstream/
