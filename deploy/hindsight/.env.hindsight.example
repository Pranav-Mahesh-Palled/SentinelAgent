# ==============================================================================
# SentinelAgent - Hindsight Local Development Environment Template
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env.hindsight in the same directory:
#      cp deploy/hindsight/.env.hindsight.example deploy/hindsight/.env.hindsight
# 2. Replace the placeholder below with a cryptographically strong 32-byte hex key:
#      python -c "import secrets; print(secrets.token_hex(32))"
# 3. Ensure deploy/hindsight/.env.hindsight is NEVER committed to version control.
#    (It is strictly git-ignored by .gitignore).
# 4. Once Hindsight is running and verified, inject the EXACT SAME key into
#    SentinelAgent's root .env file as HINDSIGHT_API_KEY.
# ==============================================================================

# Shared Secret Key for Hindsight ApiKeyTenantExtension
# Mechanism: Static shared-secret string equality comparison over HTTP Bearer auth
# Transport Protection: Bound strictly to host loopback (127.0.0.1:8888)
HINDSIGHT_API_KEY=<GENERATE_A_STRONG_RANDOM_SECRET>

