# =============================================================================
# SentinelAgent Production Deployment Configuration Example
# Copy to .env in this directory (deploy/sentinelagent/.env) and populate.
# NEVER commit the actual .env file or secrets to version control.
# =============================================================================

# --- Network & Port Binding ---
# Bind to localhost by default to prevent unintended exposure to external networks.
BIND_IP=127.0.0.1
FRONTEND_PORT=8080
API_PORT=8000

# --- Process Concurrency ---
UVICORN_WORKERS=2

# --- PostgreSQL Database Identity, Storage & Image ---
# Explicitly pinned to PostgreSQL 18.6 Alpine with verified multi-platform index digest.
POSTGRES_IMAGE=postgres:18.6-alpine@sha256:9ba53c7d41ea093baf5c1ba635ba5434c4f979880527d49bb7d9237d3193085b
POSTGRES_DB=sentinelagent
POSTGRES_USER=sentinel_admin
MIGRATION_USER=sentinel_migration_role
APP_USER=sentinel_app_role
# PGDATA defaults to the backward-compatible path: /var/lib/postgresql/data
# To adopt the official PostgreSQL 18 path on a new deployment or migrated cluster:
# PGDATA=/var/lib/postgresql/18/docker

# --- Secrets Paths (Files mounted into containers via Docker Secrets) ---
# Populate each secret file under ./secrets/ before starting Docker Compose.
POSTGRES_ADMIN_PASSWORD_FILE=./secrets/postgres_admin_password.txt
MIGRATION_PASSWORD_FILE=./secrets/migration_password.txt
APP_PASSWORD_FILE=./secrets/app_password.txt
MIGRATION_DATABASE_URL_FILE=./secrets/migration_database_url.txt
APP_DATABASE_URL_FILE=./secrets/app_database_url.txt
OPERATOR_CREDENTIALS_FILE=./secrets/operator_credentials.json
GEMINI_API_KEY_FILE=./secrets/gemini_api_key.txt

# --- Optional Integrations (Disabled in base deployment) ---
HINDSIGHT_ENABLED=false
HINDSIGHT_REQUIRED=false
HINDSIGHT_RECALL_ENABLED=false
